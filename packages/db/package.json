{
  "name": "@queueexpress/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, generated client and seed data for QueueExpress",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    }
  },
  "files": ["dist", "prisma"],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "studio": "prisma studio",
    "seed": "bun run src/seed.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('src/generated',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@queueexpress/shared": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^18.0.5",
    "prisma": "^7.10.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "bun run src/seed.ts"
  }
}