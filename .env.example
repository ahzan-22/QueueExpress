# =============================================================================
# QueueExpress - template environment variables
# Salin file ini menjadi .env di root monorepo, lalu isi nilainya.
#   copy .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database - Supabase PostgreSQL
# Ganti [YOUR-PASSWORD] dengan password database project Supabase Anda.
# Password yang sama dipakai untuk DATABASE_URL dan DIRECT_URL.
# -----------------------------------------------------------------------------

# Shared transaction-mode pooler (IPv4-only) - dipakai aplikasi saat runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Shared session-mode pooler - dipakai Prisma CLI untuk migration
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Direct connection (opsional, untuk db push di luar VPN Supabase)
# SUPABASE_DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Backend API (apps/api)
# -----------------------------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
API_GLOBAL_PREFIX="api"
# Bisa beberapa origin dipisah koma
WEB_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# Frontend (apps/web)
# NEXT_PUBLIC_* akan ikut ter-inline ke bundle browser saat build,
# jadi jangan pernah menaruh kredensial database di sini.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# -----------------------------------------------------------------------------
# Production (Vercel untuk apps/web, Railway/Render untuk apps/api)
#
# --- Railway / Render (service apps/api, root directory = repo root) ---
# Build Command:   bun install && bun run db:deploy && bun --filter @queueexpress/api build
# Start Command:   bun --filter @queueexpress/api start   (menjalankan node apps/api/dist/main.js)
# Health Check:    /api/health
# Variables:
#   DATABASE_URL="postgresql://...pooler...:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://...pooler...:5432/postgres"   (untuk prisma migrate deploy)
#   API_GLOBAL_PREFIX="api"
#   WEB_ORIGIN="https://<domain-vercel-anda>"              (boleh beberapa origin, pisah koma)
#   SKIP_SEED=true                                          (jangan seed data demo di produksi)
#   API_PORT tidak perlu di-set manual: kode otomatis fallback ke PORT
#   yang disuntik platform (lihat apps/api/src/config/env.validation.ts).
#   Kalau platform tidak menyuntik PORT, set API_PORT=<port-platform>.
#
# --- Vercel (project apps/web, Root Directory = apps/web) ---
# Framework Preset: Next.js. Install/Build default bawaan Vercel.
# PENTING: NEXT_PUBLIC_* di-inline saat BUILD, jadi set sebelum deploy
# dan redeploy tiap kali nilainya berubah. Isi TANPA akhiran /api:
#   NEXT_PUBLIC_API_URL="https://<domain-api-anda>"        (contoh: https://queueexpress-api.onrender.com)
#   NEXT_PUBLIC_SOCKET_URL="https://<domain-api-anda>"     (nilai yang sama; kode menambah /api dan /queue sendiri)
# Tidak perlu: DATABASE_URL / DIRECT_URL / API_PORT / WEB_ORIGIN di Vercel.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Seed (opsional)
# Melewati seeding saat migrate deploy supaya data demo tidak masuk produksi:
# SKIP_SEED=true
# -----------------------------------------------------------------------------