# =============================================================================
# QueueExpress - template environment variables
# Salin file ini menjadi .env di root monorepo, lalu isi nilainya.
#   copy .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database - Supabase PostgreSQL
# Ganti [YOUR-PASSWORD] dengan password database project Supabase Anda.
# Password yang sama dipakai untuk DATABASE_URL dan DIRECT_URL.
# -----------------------------------------------------------------------------

# Shared transaction-mode pooler (IPv4-only) - dipakai aplikasi saat runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Shared session-mode pooler - dipakai Prisma CLI untuk migration
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Direct connection (opsional, untuk db push di luar VPN Supabase)
# SUPABASE_DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Backend API (apps/api)
# -----------------------------------------------------------------------------
API_PORT=4000
API_URL="http://localhost:4000"
API_GLOBAL_PREFIX="api"
# Bisa beberapa origin dipisah koma
WEB_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# Frontend (apps/web)
# NEXT_PUBLIC_* akan ikut ter-inline ke bundle browser saat build,
# jadi jangan pernah menaruh kredensial database di sini.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# -----------------------------------------------------------------------------
# Production (Vercel + Railway)
# railway:   DATABASE_URL + API_PORT + API_GLOBAL_PREFIX + WEB_ORIGIN
# vercel:    NEXT_PUBLIC_API_URL + NEXT_PUBLIC_SOCKET_URL
# Railway menjalankan `node dist/main.js` dari folder apps/api
# (jalankan `bun run build` di root repo sebelum deploy)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Seed (opsional)
# Melewati seeding saat migrate deploy supaya data demo tidak masuk produksi:
# SKIP_SEED=true
# -----------------------------------------------------------------------------